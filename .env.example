# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Protects the site when it is hosted online. Leave empty only when running on your own PC.
APP_PASSWORD=

# Optional: use a session string (printed by `python login.py --string`) instead of a session file.
# Handy on hosts where the disk is wiped on every deploy.
TG_SESSION_STRING=

# Optional
PORT=8000
DATA_DIR=data
# Set to 1 to try the dashboard with fake demo data (no Telegram needed)
DEMO=0
