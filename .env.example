# Everything here is OPTIONAL. Each person enters their own Telegram API keys
# and phone number inside the app (Settings screen on first visit).

# Invite password for the whole site. Set this when hosting online so only people
# you share the password with can even reach the sign-in screen.
APP_PASSWORD=

# Optional: your API keys (https://my.telegram.org) used as the default for everyone,
# so friends only need their phone number. Leave empty to make each person bring their own.
TG_API_ID=
TG_API_HASH=

# Streaming speed: how many 1 MB chunks are downloaded from Telegram in parallel (default 4; try 6-8 on a fast
# connection, lower it if Telegram starts rate-limiting you) and how much streamed video is kept in RAM.
STREAM_LANES=4
STREAM_CACHE_MB=128

PORT=8000
DATA_DIR=data
# Set to 1 to try the dashboard with fake demo data (no Telegram needed)
DEMO=0
